{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "569102b024d24c34b4354f757ae1158e",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Calculate_Outline (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -558.0,
            "y": 204.99996948242188,
            "width": 252.99996948242188,
            "height": 125.00003051757813
        }
    },
    "m_Slots": [
        {
            "m_Id": "767081fb85144512a77988ef3bc786eb"
        },
        {
            "m_Id": "6af94e51053a4fabbbb56768e77c78b0"
        },
        {
            "m_Id": "d6b5339743a64ff0ad689272d6234d00"
        },
        {
            "m_Id": "61904974b2134cb1893bf3cdf94bdf18"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Calculate_Outline",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Dapatkan ukuran pixel layar\r\nfloat2 texel = float2(1.0 / _ScreenParams.x, 1.0 / _ScreenParams.y);\r\n\r\n// Ambil Depth di titik tengah\r\nfloat rawDepth = SHADERGRAPH_SAMPLE_SCENE_DEPTH(UV);\r\nfloat linearDepth = LinearEyeDepth(rawDepth, _ZBufferParams);\r\n\r\n// KUNCI: Semakin jauh objek (linearDepth besar), ketebalan semakin kecil\r\n// max() digunakan agar objek yang terlalu dekat tidak membuat outline raksasa\r\nfloat dynamicThickness = Thickness / max(linearDepth, 1.0);\r\nfloat2 offset = texel * dynamicThickness;\r\n\r\n// Sampling kedalaman di 4 titik sekitar pixel (Metode Roberts Cross)\r\nfloat d1 = LinearEyeDepth(SHADERGRAPH_SAMPLE_SCENE_DEPTH(UV + float2(-offset.x, -offset.y)), _ZBufferParams);\r\nfloat d2 = LinearEyeDepth(SHADERGRAPH_SAMPLE_SCENE_DEPTH(UV + float2(offset.x, offset.y)), _ZBufferParams);\r\nfloat d3 = LinearEyeDepth(SHADERGRAPH_SAMPLE_SCENE_DEPTH(UV + float2(-offset.x, offset.y)), _ZBufferParams);\r\nfloat d4 = LinearEyeDepth(SHADERGRAPH_SAMPLE_SCENE_DEPTH(UV + float2(offset.x, -offset.y)), _ZBufferParams);\r\n\r\n// Hitung perbedaan kedalaman untuk mendeteksi tepi\r\nfloat depthDifference = abs(d1 - d2) + abs(d3 - d4);\r\n\r\n// Kembalikan nilai 1 jika perbedaan kedalaman melebihi threshold (menjadi outline)\r\nEdge = step(DepthThreshold, depthDifference);"
}

