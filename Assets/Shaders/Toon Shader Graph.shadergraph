            "m_Id": "20c87ff0d8de4d60969fa0082f343e42"
        },
        {
            "m_Id": "ce70c6a37d6b47e89d2c18175964b2d2"
        },
        {
            "m_Id": "03252b1a01ce4212ad8389663ed90ef5"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GetMainLight",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if defined(SHADERGRAPH_PREVIEW)\r\n    Direction = half3(0.5, 0.5, 0);\r\n    Color = half3(1, 1, 1);\r\n    ShadowAtten = 1.0;\r\n#else\r\n    #if defined(UNIVERSAL_LIGHTING_INCLUDED)\r\n        float4 shadowCoord = TransformWorldToShadowCoord(Position);\r\n        Light light = GetMainLight(shadowCoord);\r\n        Direction = light.direction;\r\n        Color = light.color;\r\n        ShadowAtten = light.shadowAttenuation;\r\n    #else\r\n        Direction = half3(0.5, 0.5, 0);\r\n        Color = half3(1, 1, 1);\r\n        ShadowAtten = 1.0;\r\n    #endif\r\n#endif"
}

