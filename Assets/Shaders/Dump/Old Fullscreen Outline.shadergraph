{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "ad389741dc194ccba01d1d7b3208941c",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SampleNormalEdge (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 657.0,
            "y": -1041.0,
            "width": 265.99993896484377,
            "height": 142.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "e4a8a77d6f434efebd981580c871f7d0"
        },
        {
            "m_Id": "782386e8a5ce4966aeacb1b6b5078869"
        },
        {
            "m_Id": "7b25bac99e4f469bb20412fae104b861"
        },
        {
            "m_Id": "1ed24785c2214afa98e8e35367b65995"
        },
        {
            "m_Id": "d9f6f8bd3fff46fd9037e6fa6725a7ee"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SampleNormalEdge",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if defined(SHADERGRAPH_PREVIEW) || !defined(UNIVERSAL_LIGHTING_INCLUDED)\r\n    Edge = 0;\r\n#else\r\n    // 1. Cegah pembagian dengan nol. \r\n    // Data \"Depth\" di sini sudah berupa jarak asli dari kamera (Linear Eye)\r\n    float safeDepth = max(Depth, 1); \r\n\r\n    // 2. Skalakan ketebalan outline berdasarkan jarak kamera\r\n    float scaledThickness = Thickness / safeDepth;\r\n\r\n    // 3. Hitung pixel offset\r\n    float2 pixelOffset = _ScreenSize.zw * scaledThickness;\r\n\r\n    // 4. Tentukan posisi UV untuk 4 arah\r\n    float2 uvTop = UV + float2(0, pixelOffset.y);\r\n    float2 uvBottom = UV + float2(0, -pixelOffset.y);\r\n    float2 uvLeft = UV + float2(-pixelOffset.x, 0);\r\n    float2 uvRight = UV + float2(pixelOffset.x, 0);\r\n\r\n    // 5. Ambil data Normal\r\n    float3 nTop = SHADERGRAPH_SAMPLE_SCENE_NORMAL(uvTop).xyz;\r\n    float3 nBottom = SHADERGRAPH_SAMPLE_SCENE_NORMAL(uvBottom).xyz;\r\n    float3 nLeft = SHADERGRAPH_SAMPLE_SCENE_NORMAL(uvLeft).xyz;\r\n    float3 nRight = SHADERGRAPH_SAMPLE_SCENE_NORMAL(uvRight).xyz;\r\n\r\n    // 6. Hitung selisih jarak vektor\r\n    float diffH = length(nLeft - nRight);\r\n    float diffV = length(nTop - nBottom);\r\n\r\n    float combinedDiff = diffH + diffV;\r\n\r\n    // 7. Output akhir\r\n    Edge = step(Threshold, combinedDiff);\r\n#endif"
}

